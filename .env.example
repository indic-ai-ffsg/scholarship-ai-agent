# Copy to `.env` and fill in. `.env` is gitignored - never commit a real key.

# --- Required: Gemini API key (https://aistudio.google.com/apikey) ---
LLM_API_KEY=

# --- Optional: extraction model (default: gemini-2.5-flash) ---
# MODEL=gemini-2.5-flash

# --- Optional: Redis ---
# Finished extractions are cached for 7 days, so re-running the same URL or
# text costs nothing. Redis is optional: without it the tool still runs and
# just calls the model every time.
#
# A hosted instance (Railway, Upstash, ...):
# REDIS_URL=redis://default:PASSWORD@HOST:PORT
#
# Or a local server (brew services start redis):
# REDIS_URL=redis://localhost:6379/0
#
# Or host/port instead of a URL:
# REDIS_HOST=localhost
# REDIS_PORT=6379
#
# --- Optional: agentic gathering budget ---
# After reading the page you give it, the model may follow links on the same
# site to fill gaps. These cap what that can cost.
# SCHOLARSHIP_MAX_PAGES=5            # pages per extraction, including the seed
# SCHOLARSHIP_MAX_STEPS=8            # tool-calling turns
# SCHOLARSHIP_MAX_SECONDS=120        # wall clock for the gathering phase
# SCHOLARSHIP_ALLOWED_DOMAINS=sbiashascholarship.co.in,sbifoundation.in
#                                    # extra hosts it may open; the source site
#                                    # is always allowed, nothing else is

# --- Optional: who may start a run -------------------------------------------
# The admin panel calls this service through its own origin (/discovery) and
# sends its Authorization header with every run. Set this to an ordinary,
# read-only admin endpoint and the token is handed straight to it: 2xx means the
# caller is a platform user who may author listings, anything else is refused.
# This service keeps no accounts and issues nothing - it only ever asks.
#
# Unset, every run is allowed. That is right for a service on localhost with you
# in front of it, and wrong the moment the panel that reaches it is on the
# internet: this fetches whatever URL it is given and spends model credits doing
# it. Set it whenever DISCOVERY_TARGET is set on the panel.
# DISCOVERY_VERIFY_URL=https://sship-api.indic-ai.org/api/v1/admin/scholarships?page_size=1

# --- Optional: where the panel mounts this -----------------------------------
# The panel calls /discovery/api/..., and this prefix is stripped from an
# incoming path when it is there, so nothing has to rewrite URLs. Change it only
# if the panel is served from somewhere else.
# DISCOVERY_PATH_PREFIX=/discovery

# --- Optional: cross-origin callers ------------------------------------------
# Comma-separated origins allowed to call this directly, for the case where the
# panel is NOT proxying it. Empty is the intended state.
# DISCOVERY_ALLOWED_ORIGINS=http://localhost:5174

# --- Optional: automatic re-checking -----------------------------------------
# How often the running service re-checks every watched page. Unset or 0 means
# it does not, and `python main.py --refresh` remains the only way.
#
# Cheap by construction: every watched URL is re-fetched and hashed, and the
# model is called only for the pages whose text actually moved. A nightly sweep
# over two hundred unchanged pages costs two hundred HTTP requests and no API
# spend. Off by default anyway - a service should not start spending because
# somebody ran `python server.py`.
#
# Results are read from GET /api/refresh; POST /api/refresh sweeps now. Nothing
# is written back to the platform: a moved deadline is a finding for an operator
# to act on, not an edit this service is entitled to make.
# DISCOVERY_REFRESH_HOURS=24

# --- Optional: freshness ---
# How near a deadline counts as "closing soon" in `python main.py --refresh`.
# SCHOLARSHIP_CLOSING_SOON_DAYS=7

# To inspect or clear the cache, point redis-cli at the same instance - plain
# `redis-cli` talks to 127.0.0.1 and will not see a hosted one:
#   redis-cli -u "$REDIS_URL" keys 'scholarship_cache:*'
#   redis-cli -u "$REDIS_URL" flushall
